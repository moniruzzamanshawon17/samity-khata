# Database (docker compose reads these)
POSTGRES_DB=samity_khata
POSTGRES_USER=samity
POSTGRES_PASSWORD=
DB_HOST_PORT=5433

# Used when running the app outside Docker. Compose overrides it.
# The password must match POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://samity:CHANGE_ME@localhost:5433/samity_khata

# Auth (required)
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# Chat model (required)
LLM_API_KEY=
LLM_MODEL=

# Embeddings (required)
# multilingual-e5-small produces 384 dimensions. The pgvector column must use the same size.
EMBEDDING_URL=http://localhost:8080
EMBEDDING_DIM=384
# Distance cut-off for "not in the bylaws". Tune it with your test questions.
RAG_SIMILARITY_THRESHOLD=0.35

# Host ports
API_HOST_PORT=8002
EMBEDDING_HOST_PORT=8080

APP_ENV=development