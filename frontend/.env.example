# Where `npm run dev` / `npm run preview` forward /api/* (the FastAPI backend).
VITE_API_PROXY_TARGET=http://localhost:8002

# Base URL the browser calls. Keep the default (/api/v1) when using the proxy
# or a same-origin rewrite. Set a full URL (https://your-api.onrender.com/api/v1)
# only if the backend sends CORS headers for this site.
VITE_API_BASE=/api/v1

# Shown on the Settings page so people can connect an MCP client.
VITE_MCP_URL=http://localhost:8003/mcp
